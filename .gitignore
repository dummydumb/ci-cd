# ===== Build output (regenerated by Eclipse/compiler) =====
build/
bin/
target/
out/
*.class

# ===== Logs & temp =====
*.log
*.tmp
*.bak
*~

# ===== OS files =====
.DS_Store
Thumbs.db
desktop.ini

# ===== IDE (keep .classpath/.project so the project imports cleanly,
#        but ignore per-user Eclipse state) =====
.settings/
.metadata/
*.launch

